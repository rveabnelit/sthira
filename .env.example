# ─── Приложение ───────────────────────────────────────────────────────────────
# Публичный адрес приложения (используется в письмах, sitemap и Open Graph)
NEXT_PUBLIC_APP_URL=http://localhost:3100
NODE_ENV=development

# ─── База данных ──────────────────────────────────────────────────────────────
# SQLite-файл. Каталог data/ создаётся автоматически.
DATABASE_PATH=./data/sthira.db

# ─── Платежи (тестовый провайдер) ─────────────────────────────────────────────
# Секрет для проверки подписи webhook. В production задайте длинное случайное значение.
PAYMENT_WEBHOOK_SECRET=sthira-dev-webhook-secret

# ─── Демо-режим ───────────────────────────────────────────────────────────────
# true  — создаются демо-аккаунты и показываются ссылки подтверждения/восстановления
# false — чистая база без демо-данных (для production)
DEMO_MODE=true
SEED_DEMO_DATA=true
# Какие демо-аккаунты показывать на странице входа:
# all — ученик и администратор, student — только ученик, false — не показывать
SHOW_DEMO_HINTS=all

# ─── STHIRA Guide ─────────────────────────────────────────────────────────────
# Дневной лимит сообщений на пользователя
GUIDE_DAILY_LIMIT=30
# Для production: провайдер внешней модели (в MVP используется локальный демо-провайдер)
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL=

# ─── Диагностика ──────────────────────────────────────────────────────────────
# Показывать служебные endpoints (GET /api/v1/webhooks/payment-provider)
ALLOW_DEBUG_ENDPOINTS=true
